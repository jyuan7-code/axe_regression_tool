; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "GraphicRegressionTool"
#define MyAppVersion "2.0"
#define MyAppPublisher "Yuan Jin"
#define MyAppExeName "graphic_regression_tool.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{C0F83E57-0CFB-40D2-9DDF-55EF92C83199}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={autopf}\{#MyAppName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
LicenseFile=D:\fulsimsrc\axe_regression_tool\release\license.txt
; Uncomment the following line to run in non administrative install mode (install for current user only.)
;PrivilegesRequired=lowest
OutputDir=D:\fulsimsrc\regesion_tool
OutputBaseFilename=graphic_regression_tool_261022_setup
SetupIconFile=D:\fulsimsrc\axe_regression_tool\release\setup.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "D:\fulsimsrc\axe_regression_tool\release\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "D:\fulsimsrc\axe_regression_tool\release\runTestRunList.py"; DestDir: "{app}"; Flags: ignoreversion
Source: "D:\fulsimsrc\axe_regression_tool\release\icon\intel2.ico";DestDir: "{app}"; Flags: ignoreversion
Source: "D:\fulsimsrc\axe_regression_tool\release\libs\*"; DestDir: "{app}/libs"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "D:\fulsimsrc\axe_regression_tool\release\icon\*"; DestDir: "{app}/icon"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "D:\fulsimsrc\axe_regression_tool\release\executions\*"; DestDir: "{app}/executions"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\intel2.ico"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; IconFilename: "{app}\intel2.ico"

Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\intel2.ico"
Name: "{userdesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\intel2.ico"
[Registry]
; Ensure the taskbar icon is set
[Code]
function InitializeSetup(): Boolean;
begin
  Result := True;
end;

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

